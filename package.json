{
  "name": "servirtium-site",
  "version": "2.0.0",
  "description": "Build tooling for the Servirtium website (Tailwind CSS on Jekyll)",
  "private": true,
  "scripts": {
    "css:build": "tailwindcss -i static/css/tailwind.css -o static/css/app.css --minify",
    "css:watch": "tailwindcss -i static/css/tailwind.css -o static/css/app.css --watch",
    "build": "npm run css:build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/servirtium/site.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.1"
  }
}
